  (text "Map U3 Q0-Q7 to U7 IN1-IN8. U7 OUT1-OUT8 pass through R13-R20 to SEG_A-SEG_DP buses." (at 25 102 0)
    (effects (font (size 1.27 1.27)))
    (uuid "8f8b7c93-c534-4280-96af-0c6e4ef2040d")
  )
  (text "R13-R20: 220R to 330R, one resistor per segment bus." (at 25 110 0)
    (effects (font (size 1.27 1.27)))
    (uuid "8f8b7c93-c534-4280-96af-0c6e4ef2040e")
  )
  (text "Display pin mapping for each 3621BH: A=3, B=9, C=8, D=6, E=7, F=4, G=1, DP=2." (at 25 118 0)
    (effects (font (size 1.27 1.27)))
    (uuid "8f8b7c93-c534-4280-96af-0c6e4ef2040f")
  )
  (text "All four displays share the same segment buses: tie all A pins together, all B pins together, and so on." (at 25 126 0)
