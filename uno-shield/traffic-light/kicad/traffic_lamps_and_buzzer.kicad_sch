    (effects (font (size 1.27 1.27)))
    (uuid "4b5f713f-9da7-49e7-95b9-5b8f391d0312")
  )
  (text "U5 channel map: IN1/OUT1 NR, IN2/OUT2 NY, IN3/OUT3 NG, IN4/OUT4 SR, IN5/OUT5 SY, IN6/OUT6 SG, IN7/OUT7 ER, IN8/OUT8 EY." (at 25 108 0)
    (effects (font (size 1.27 1.27)))
    (uuid "4b5f713f-9da7-49e7-95b9-5b8f391d0313")
  )
  (text "U6 channel map: IN1/OUT1 EG, IN2/OUT2 WR, IN3/OUT3 WY, IN4/OUT4 WG, IN5/OUT5 BUZZER_EN. IN6-IN8 reserved." (at 25 116 0)
    (effects (font (size 1.27 1.27)))
    (uuid "4b5f713f-9da7-49e7-95b9-5b8f391d0314")
  )
  (text "BZ1 active buzzer: + pin -> +5V, - pin -> U6 OUT5. BUZZER_EN high turns it on." (at 25 124 0)
    (effects (font (size 1.27 1.27)))
    (uuid "4b5f713f-9da7-49e7-95b9-5b8f391d0315")
  )
