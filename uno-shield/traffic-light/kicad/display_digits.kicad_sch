  (text "Each digit line drives one BC327 base through 1k to 2.2k resistor and has a 10k pull-up to +5V." (at 25 102 0)
    (effects (font (size 1.27 1.27)))
    (uuid "2c2b6d22-9274-4955-b79f-98144176050d")
  )
  (text "BC327 connection rule: emitter -> +5V, collector -> digit common pin, base <- SR4 output through resistor." (at 25 110 0)
    (effects (font (size 1.27 1.27)))
    (uuid "2c2b6d22-9274-4955-b79f-98144176050e")
  )
  (text "Digit is active low: SR4 output LOW turns BC327 on and applies +5V to the selected common anode." (at 25 118 0)
    (effects (font (size 1.27 1.27)))
    (uuid "2c2b6d22-9274-4955-b79f-98144176050f")
  )
  (text "DS1 North: DIG1 pin10 <- DIG_N_TEN, DIG2 pin5 <- DIG_N_ONE." (at 25 128 0)
